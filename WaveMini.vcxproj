<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A3A2436D-D7E2-4D0B-B905-7D9575B83C60}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>WaveMini</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)build\vs\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)build\vs\obj\$(Platform)\$(Configuration)\</IntDir>
    <WebView2Native>$(ProjectDir)packages\Microsoft.Web.WebView2.1.0.2903.40\build\native</WebView2Native>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;HAVE_WEBVIEW2;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(WebView2Native)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)' == 'Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)' == 'Release'">MinSpace</Optimization>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)res;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>wWinMainCRTStartup</EntryPointSymbol>
      <AdditionalLibraryDirectories>$(WebView2Native)\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>WebView2LoaderStatic.lib;version.lib;d2d1.lib;dwrite.lib;windowscodecs.lib;winhttp.lib;bcrypt.lib;crypt32.lib;shlwapi.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;runtimeobject.lib;user32.lib;gdi32.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation Condition="'$(Configuration)' == 'Debug'">true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\audio.cpp" />
    <ClCompile Include="src\mp4.cpp" />
    <ClCompile Include="src\core.cpp" />
    <ClCompile Include="src\gfx.cpp" />
    <ClCompile Include="src\main.cpp" />
    <ClCompile Include="src\player.cpp" />
    <ClCompile Include="src\signin.cpp" />
    <ClCompile Include="src\ui.cpp" />
    <ClCompile Include="src\yt.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="res\resource.h" />
    <ClInclude Include="src\app.h" />
    <ClInclude Include="src\audio.h" />
    <ClInclude Include="src\mp4.h" />
    <ClInclude Include="src\core.h" />
    <ClInclude Include="src\gfx.h" />
    <ClInclude Include="src\media_abi.h" />
    <ClInclude Include="src\playback_clock.h" />
    <ClInclude Include="src\signin.h" />
    <ClInclude Include="src\yt.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="res\app.rc" />
    <Image Include="res\wavemini.ico" />
    <None Include="CMakeLists.txt" />
    <None Include="packages.config" />
    <None Include="README.md" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CheckWebView2Package" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(WebView2Native)\x64\WebView2LoaderStatic.lib')"
           Text="Restore NuGet packages for WaveMini.sln before building. Microsoft.Web.WebView2 is required." />
  </Target>
</Project>
